# GEMINI_API_KEY: Required for Gemini AI Vision waste segregation and Voice Assistant (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript API Key.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign authentication session tokens.
SESSION_SECRET="change-me-in-production"

# SUPABASE: Optional external Supabase project credentials for PostgreSQL sync, Storage & Realtime GPS.
# Keep SUPABASE_SERVICE_ROLE_KEY strictly on the server (never prefix with VITE_).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
